{
  "name": "imgpkg-tool",
  "productName": "加密压缩",
  "version": "1.1.2",
  "description": "零知识加密附件工具 - 将加密压缩包隐藏进图片或视频内部",
  "author": "B站青春沿岸",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "electron:build": "npm run build && electron-builder",
    "dist:installer": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.imgpkg.tool",
    "productName": "加密压缩",
    "directories": {
      "output": "release",
      "buildResources": "electron/resources"
    },
    "electronDist": ".cache/electron-dist",
    "electronVersion": "31.7.7",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/resources/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-便携版-${version}.${ext}"
    }
  }
}
